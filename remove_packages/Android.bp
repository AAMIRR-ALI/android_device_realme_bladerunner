android_app_import {
    name: "RemovePackages",
    apk: "DebloatDummy.apk",
    presigned: true,
    preprocessed: true,

    overrides: [
        "CalendarGoogle",
        "Drive",
        "Etar",
        "Flash",
        "Gallery2",
        "Gmail2",
        "Glimpse",
        "GoogleCamera",
        "Jelly",
        "Maps",
        "Messaging",
        "MatLog",
    ],

    dex_preopt: {
        enabled: false,
    },
    privileged: false,
}
